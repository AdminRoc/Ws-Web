# ============================================================================
# EdgeOne Pages 缓存规则
# 规则优先级：具体文件路径 > 目录 > 文件后缀 > 全部文件
# 来源：原 CDN 30 条节点缓存 + 浏览器缓存规则合并
# 2026-08-07 恢复完整版（此前因 HSTS 干扰 _headers 不生效而简化）
# ============================================================================

# ── 默认：所有文件 ──
/*
  Cache-Control: public, max-age=600, s-maxage=86400

# ── HTML：不缓存（动态内容，每次请求最新） ──
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
/*.htm
  Cache-Control: no-cache, no-store, must-revalidate

# ── CSS：长期缓存 365 天（内容哈希版本化） ──
/*.css
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# ── JS：长期缓存 365 天（内容哈希版本化；/data 下的 JS 会被具体路径规则覆盖） ──
/*.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# ── JSON：边缘缓存 10 分钟，浏览器缓存 1 分钟 ──
/*.json
  Cache-Control: public, max-age=60, s-maxage=600

# ── 字体文件：长期缓存 1 年（静态资源，文件名无 hash 不加 immutable，便于未来更新时强制刷新生效） ──
/*.ttf
  Cache-Control: public, max-age=31536000, s-maxage=31536000
/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=31536000
/*.woff
  Cache-Control: public, max-age=31536000, s-maxage=31536000
/*.otf
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.eot
  Cache-Control: public, max-age=2592000, s-maxage=2592000

# ── 图片文件：缓存 30 天 ──
/*.png
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.jpg
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.gif
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.svg
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.webp
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.ico
  Cache-Control: public, max-age=2592000, s-maxage=2592000
/*.bmp
  Cache-Control: public, max-age=2592000, s-maxage=2592000

# ══════════════════════════════════════════════════════════════════════════════
# /data 目录 — 按数据类型精确控制
# ══════════════════════════════════════════════════════════════════════════════

# ── /data 默认：缓存 1 小时 ──
/data/*
  Cache-Control: public, max-age=3600, s-maxage=3600

# ── /data/i18n 目录：缓存 1 天（国际化数据低频变化） ──
/data/i18n/*
  Cache-Control: public, max-age=86400, s-maxage=86400

# ── /data/auction-dicts 目录：缓存 1 小时 ──
/data/auction-dicts/*
  Cache-Control: public, max-age=3600, s-maxage=3600

# ── /fonts 目录：缓存 30 天 ──
/fonts/*
  Cache-Control: public, max-age=2592000, s-maxage=2592000

# ══════════════════════════════════════════════════════════════════════════════
# 世界状态文件 — 边缘缓存 2 分钟，浏览器缓存 1 分钟
# stale-while-revalidate：过期后先返回旧值，后台静默更新
# ══════════════════════════════════════════════════════════════════════════════
/data/worldstate-all.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/worldstate-snapshot.js
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/ws-intl-zh.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/ws-intl-en.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/ws-cn-zh.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/ws-cn-en.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/cn-solnodes.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300
/data/ws-cn-null00.json
  Cache-Control: public, max-age=60, s-maxage=120, stale-while-revalidate=300

